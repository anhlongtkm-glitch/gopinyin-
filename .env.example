# ===== GoPinyin deployment config =====
# Copy this file to .env and fill real values for your deployment.

# Public site configuration
GOPINYIN_APP_NAME="GoPinyin"
GOPINYIN_SITE_URL="https://gopinyin.io.vn"
GOPINYIN_SUPPORT_EMAIL="hotro@gopinyin.app"


# Optional AI backend configuration
GOPINYIN_AI_PROXY_URL=""
GOPINYIN_PRON_API_URL=""
# Backend-only credentials; leave blank when services are not enabled.
AI_KEY_GEMINI=""
AI_KEY_OPENROUTER=""
AI_MODEL_GEMINI=""
AI_MODEL_OPENROUTER=""
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="southeastasia"
USER_RATE_PER_MINUTE=120
MAX_CONCURRENT_REQUESTS=20
UPSTREAM_TIMEOUT_MS=30000

# Optional custom domain or app metadata
GOPINYIN_DOMAIN="gopinyin.io.vn"

# Public Supabase configuration (publishable key only; never a secret/service_role key)
GOPINYIN_SUPABASE_URL=""
GOPINYIN_SUPABASE_PUBLISHABLE_KEY=""
# Optional standalone API server uses the same project, without the GOPINYIN_ prefix.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
